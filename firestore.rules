rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the people listed here can read or change the daily reports.
    // Replace PASTE_USER_UID with the User UID from Firebase > Authentication > Users.
    // Add more UIDs inside the brackets, separated by commas, for other people.
    match /reports/{date} {
      allow read, write: if request.auth != null
                         && request.auth.uid in ['PASTE_USER_UID'];
    }
  }
}
